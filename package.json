{
	"name": "@liquicode/jsonstor-postgres",
	"version": "0.1.0",
	"description": "A jsonstor adapter which stores documents in a PostgreSql database.",
	"license": "MIT",
	"engines": {
		"node": ">=16.0.0"
	},
	"homepage": "http://jsonstor.liquicode.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/liquicode/jsonstor-postgres"
	},
	"authors": [
		{
			"name": "Andre' G. Bowlin",
			"email": "agbowlin@gmail.com",
			"homepage": "http://liquicode.com"
		}
	],
	"type": "commonjs",
	"main": "src/jsonstor-postgres.js",
	"types": "./types/jsonstor-postgres.d.ts",
	"exports": {
		".": {
			"types": "./types/jsonstor-postgres.d.ts",
			"import": "./src/jsonstor-postgres.mjs",
			"require": "./src/jsonstor-postgres.js",
			"default": "./src/jsonstor-postgres.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"publish version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js publish_version",
		"start new version": "npx @liquicode/devops --tasks .\\build\\devops.tasks.js start_new_version"
	},
	"keywords": [
		"jsonstor",
		"postgres",
		"postgresql",
		"mongo query"
	],
	"devDependencies": {
		"@liquicode/devops": "^0.1.0"
	},
	"dependencies": {
		"@liquicode/jsongin": "^0.1.0",
		"@liquicode/jsonstor": "^0.1.0",
		"pg": "^8.13.0"
	}
}
